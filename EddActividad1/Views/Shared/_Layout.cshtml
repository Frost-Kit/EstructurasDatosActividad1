<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - EddActividad1</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/EddActividad1.styles.css" asp-append-version="true"/>
</head>
<body style="background-color: #f1f5f9">
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark border-bottom box-shadow mb-3"
         style="background-color: #1e293b">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="" asp-controller="Evacuacion" asp-action="Index">Estructuras de Datos - Actividad 1</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-light" asp-controller="Micro" asp-action="Index">
                            <i class="bi bi-truck"></i> Flota de Micros
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-light" asp-controller="Micro" asp-action="Operadores">
                            <i class="bi bi-arrow-left-right"></i> Operadores
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-light" asp-controller="Micro" asp-action="Recursividad">
                            <i class="bi bi-exclamation-triangle"></i> Recursividad
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-light" style="background-color: #1e293b">
    <div class="container">
        <p>&copy; 2026 - Estructuras de datos - Actividad 1 - Cristhian Leonardo Flores Carballo | 
            <a asp-area="" asp-controller="Home" asp-action="Privacy" style="color: #38bdf8">Privacy</a></p>
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>